# Copy this file to .env and fill in real values. NEVER commit .env.

# --- App ---
APP_ENV=development
APP_NAME=Nexora AI
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# --- Database ---
# Development default (SQLite):
DATABASE_URL=sqlite:///./nexora.db
# Production example (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/nexora

# --- Auth ---
JWT_SECRET=change-me-too
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI providers (leave blank to use the labeled MOCK provider) ---
AI_DEFAULT_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
